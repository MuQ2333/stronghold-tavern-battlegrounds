+    } finally { switched.m.dispose(); }
+  }
+  const h = makeMatch({ fake: true, mode: 'solo', data: on.data, rules: on.rules, cs: on.cs, requireCs: true });
+  t.after(() => h.m.dispose());
+  h.start(); h.toPrep(1, { band: heroes[0].bandId });
+  const ps = h.ps('p_0');
