@@ -0,0 +1,66 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+
+test('server-streamed layers grow during combat without private refresh; Yogg cast stays prominent and inspectable', {
+  skip: process.env.SP_E2E !== '1' || !process.env.CHROME_PATH, timeout: 90000,
+}, async () => {
+  const { startServer } = await import('../../server/index.js');
+  const puppeteer = (await import('puppeteer-core')).default;
+  const srv = await startServer({ port: 0, host: '127.0.0.1', quiet: true });
+  const browser = await puppeteer.launch({ executablePath: process.env.CHROME_PATH, headless: true, args: ['--no-sandbox','--mute-audio'] });
+  const page = await browser.newPage(), errors = [];
+  page.on('pageerror', e => errors.push(e.message));
+  fs.mkdirSync('.cache/live-layer-browser', { recursive: true });
+  try {
+    await page.setViewport({ width: 1600, height: 900 });
+    await page.goto(`${srv.url}/dev/game-mock.html?phase=COMBAT&render=fallback&shot=1`, { waitUntil: 'domcontentloaded' });
+    await page.waitForSelector('.gm__bonds .bond__count');
+    await page.evaluate(() => {
+      const mock = globalThis.__MOCK__;
+      clearInterval(mock.S().battle.timer);
+      mock.mutate(s => { s.pub.growthMode = true; s.pub.disabledBonds = []; s.priv.board[0].id = 'chess_char_3_06_a'; });
+    });
+    const push = async n => page.evaluate(async n => {
+      const { net } = await import('/js/net.js');
+      const s = globalThis.__MOCK__.store.get(), pid = s.me.playerId, fid = s.match.field.fieldId;
+      net._emit('b.snap', { t: 'b.snap', fieldId: fid, gt: n, units: [], killed: 0, total: 9, bondLayers: { [pid]: { sargonShip: n } } });
+      net._emit('b.snap', { t: 'b.snap', fieldId: fid, gt: n + 0.1, units: [], killed: 0, total: 9 });
+    }, n);
+    await push(1500);
+    await page.waitForFunction(() => document.querySelector('[data-bond="sargonShip"] .bond__count')?.textContent === '1.5k');
+    await push(21300);
+    await page.waitForFunction(() => document.querySelector('[data-bond="sargonShip"] .bond__count')?.textContent === '21.3k');
+    assert.equal(await page.$eval('[data-bond="sargonShip"] .bond__count', el => el.title), '21300');
+    await page.click('[data-bond="sargonShip"] button');
+    await page.waitForFunction(() => document.querySelector('.bpop__facts')?.textContent.includes('21.3k'));
+    await page.keyboard.press('Escape');
+    await push(1000000);
+    await page.waitForFunction(() => document.querySelector('[data-bond="sargonShip"] .bond__count')?.textContent === '1.0M');
+    const state = await page.evaluate(() => globalThis.__MOCK__.store.get());
+    assert.equal(state.match.public.phase, 'COMBAT');
+    assert.ok(!state.match.private.bonds.some(b => b.bondId === 'sargonShip' && b.layers >= 1500), 'no post-combat private update supplied the visible counts');
+    await page.screenshot({ path: '.cache/live-layer-browser/sargon-million-in-combat.png' });
+    await page.evaluate(() => {
+      globalThis.__MOCK__.setPhase('PREP');
+      globalThis.__MOCK__.mutate(s => { s.pub.round = 3; s.priv.heroPower = {
+        id: 'yogg', name: '尤格-萨隆', desc: '', price: 0, passive: true, round: 3, cooldown: 0, locked: [], choices: [], targets: [],
+        lastSpell: { id: 'hs_bg33_101', round: 3, targetId: 'chess_char_3_06_a' },
+      }; });
+    });
+    await page.waitForSelector('[data-testid="hero-auto-spell"]');
+    assert.ok((await page.$eval('[data-testid="hero-auto-spell"]', el => el.textContent)).includes('新生幼苗'));
+    assert.ok((await page.$eval('[data-testid="hero-auto-spell"]', el => el.textContent)).includes('菲莱'));
+    await new Promise(r => setTimeout(r, 2500));
+    assert.ok(await page.$('[data-testid="hero-auto-spell"]'), 'survives an ordinary short toast');
+    await page.screenshot({ path: '.cache/live-layer-browser/yogg-cast-notice.png' });
+    await page.waitForFunction(() => !document.querySelector('[data-testid="hero-auto-spell"]'), { timeout: 2000 });
+    await page.hover('.hero-power__toggle'); await page.waitForSelector('.hero-power__facts');
+    assert.ok((await page.$eval('.hero-power__facts', el => el.textContent)).includes('新生幼苗'));
+    assert.deepEqual(errors, []);
+  } catch (error) {
+    await page.screenshot({ path: '.cache/live-layer-browser/failure.png' }).catch(() => {});
+    fs.writeFileSync('.cache/live-layer-browser/failure.json', JSON.stringify({ error: String(error), errors, text: await page.evaluate(() => document.body.innerText) }, null, 2));
+    throw error;
+  } finally { await browser.close(); await srv.close(); }
+});
diff --git a/test/ui/mobile-viewport-basic.e2e.test.js b/test/ui/mobile-viewport-basic.e2e.test.js
new file mode 100644
index 000000000..11c018b2c
--- /dev/null
+++ b/test/ui/mobile-viewport-basic.e2e.test.js
@@ -0,0 +1,52 @@
+// Desktop Chrome emulation checks page containment and delayed recovery, not native Android system UI.
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {existsSync,mkdirSync} from 'node:fs';
+const chrome=process.env.CHROME_PATH;
+test('basic mobile fullscreen retains root containment, list scroll and editing after delayed recovery',{
+ skip:process.env.SP_E2E!=='1'||!chrome||!existsSync(chrome),timeout:60000,
+},async()=>{
+ const {startServer}=await import('../../server/index.js');
+ const puppeteer=(await import('puppeteer-core')).default;
+ const srv=await startServer({port:0,host:'127.0.0.1',quiet:true});let browser;
+ try{
+  browser=await puppeteer.launch({executablePath:chrome,headless:true,args:['--no-sandbox','--disable-gpu']});
+  const page=await browser.newPage(),errors=[];page.on('pageerror',e=>errors.push(e.message));
+  await page.setViewport({width:844,height:390,isMobile:true,hasTouch:true,isLandscape:true});
+  await page.goto(`http://127.0.0.1:${srv.port}/`,{waitUntil:'networkidle0'});
+  await page.waitForSelector('.app-root');
+  await page.evaluate(()=>{const b=document.createElement('button');b.id='viewport-fullscreen-test';b.textContent='Fullscreen';b.style.cssText='position:fixed;top:100px;left:100px;z-index:99999';b.onclick=()=>document.documentElement.requestFullscreen();document.body.append(b);});
+  await page.click('#viewport-fullscreen-test');await page.waitForFunction(()=>!!document.fullscreenElement);
+  await page.evaluate(()=>document.querySelector('#viewport-fullscreen-test').remove());
+  const cdp=await page.createCDPSession();
+  await cdp.send('Input.synthesizeScrollGesture',{x:420,y:30,yDistance:160,speed:500,gestureSourceType:'touch'});
+  await page.evaluate(()=>{scrollTo(20,90);dispatchEvent(new Event('scroll'));});
+  await page.waitForFunction(()=>scrollX===0&&scrollY===0&&document.scrollingElement.scrollTop===0);
+  await page.evaluate(async()=>{(await import('/js/screens/title.js')).enterSession('视口回归');});
+  await page.waitForSelector('.lobby-screen .spell-preview-entry');
+  mkdirSync('.cache/viewport-basic',{recursive:true});await page.screenshot({path:'.cache/viewport-basic/lobby.png'});
+  await page.click('.spell-preview-entry');
+  await page.waitForSelector('.spell-preview-row');
+  await new Promise(r=>setTimeout(r,300));
+  const list=await page.$eval('.lo-list',el=>{const r=el.getBoundingClientRect();return{x:r.x+r.width/2,y:r.bottom-25,overflow:el.scrollHeight-el.clientHeight};});
+  assert.ok(list.overflow>50,'real spell list overflows');
+  await cdp.send('Input.dispatchTouchEvent',{type:'touchStart',touchPoints:[{x:list.x,y:list.y}]});
+  for(let i=1;i<=10;i++){await cdp.send('Input.dispatchTouchEvent',{type:'touchMove',touchPoints:[{x:list.x,y:list.y-i*12}]});await new Promise(r=>setTimeout(r,20));}
+  await cdp.send('Input.dispatchTouchEvent',{type:'touchEnd',touchPoints:[]});
+  await page.waitForFunction(()=>document.querySelector('.lo-list').scrollTop>0);
+  await new Promise(r=>setTimeout(r,500));
+  const before=await page.$eval('.lo-list',el=>el.scrollTop);
+  // Getter injection models an event followed by a late metric change only; it cannot recreate OS bars.
+  await page.evaluate(()=>{globalThis.__testHeight=visualViewport.height;Object.defineProperty(visualViewport,'height',{configurable:true,get:()=>globalThis.__testHeight});visualViewport.dispatchEvent(new Event('resize'));setTimeout(()=>{globalThis.__testHeight=350;},180);});
+  await page.waitForFunction(()=>getComputedStyle(document.documentElement).getPropertyValue('--sp-vh').trim()==='3.5px');
+  assert.equal(await page.$eval('.lo-list',el=>el.scrollTop),before,'recovery preserves inner scroll');
+  await page.click('.spell-preview__search input');await page.keyboard.type('背靠背');
+  await page.evaluate(()=>document.dispatchEvent(new Event('touchend')));
+  await page.waitForFunction(()=>document.activeElement===document.querySelector('.spell-preview__search input'));
+  assert.equal(await page.$eval('.spell-preview__search input',el=>el.value),'背靠背');
+  await page.evaluate(()=>{delete visualViewport.height;visualViewport.dispatchEvent(new Event('resize'));});
+  await page.waitForFunction(()=>Math.abs(document.querySelector('.app-root').getBoundingClientRect().height-visualViewport.height)<1);
+  mkdirSync('.cache/viewport-basic',{recursive:true});await page.screenshot({path:'.cache/viewport-basic/fullscreen-preview.png'});
+  assert.deepEqual(errors,[]);
+ }finally{await browser?.close();await srv.close();}
+});
diff --git a/test/ui/mobile-viewport.test.js b/test/ui/mobile-viewport.test.js
new file mode 100644
index 000000000..a4a398243
--- /dev/null
+++ b/test/ui/mobile-viewport.test.js
@@ -0,0 +1,77 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {visibleViewport,installViewportSupport} from '../../public/js/ui/viewport.js';
+function events(){const all=new Map();return {addEventListener(k,f){if(!all.has(k))all.set(k,new Set());all.get(k).add(f);},removeEventListener(k,f){all.get(k)?.delete(f);},dispatchEvent(e){for(const f of all.get(e.type)||[])f(e);},count(k){return all.get(k)?.size||0;}};}
+function fixture(){
+ const css=new Map(),classes=new Set(),root={style:{setProperty:(k,v)=>css.set(k,v)},classList:{add:k=>classes.add(k),remove:k=>classes.delete(k)}};
+ const doc=Object.assign(events(),{documentElement:root,activeElement:null,scrollingElement:{scrollTop:0,scrollLeft:0}});
+ const vv=Object.assign(events(),{width:844,height:390,offsetTop:0,offsetLeft:0});
+ const win=Object.assign(events(),{document:doc,visualViewport:vv,innerWidth:844,innerHeight:390,scrollX:0,scrollY:0,Event:class{constructor(type){this.type=type;}},scrollTo(x,y){this.scrollX=x;this.scrollY=y;}});
+ return {win,doc,vv,css,classes};
+}
+test('fullscreen system-bar pan does not become a permanent page offset',()=>{
+ const f=fixture(),p=installViewportSupport(f.win);
+ try {
+  f.win.scrollY=31;f.doc.scrollingElement.scrollTop=31;f.doc.scrollingElement.scrollLeft=5;
+  f.vv.offsetTop=31;f.vv.offsetLeft=5;f.vv.height=359;f.vv.dispatchEvent({type:'scroll'});
+  assert.deepEqual([f.win.scrollY,f.doc.scrollingElement.scrollTop,f.doc.scrollingElement.scrollLeft],[0,0,0]);
+  assert.equal(f.css.get('--sp-vy'),'0px');assert.equal(f.css.get('--sp-vh'),'3.59px');
+  f.vv.offsetTop=0;f.vv.height=390;f.win.dispatchEvent({type:'focus'});
+  assert.equal(f.css.get('--sp-vh'),'3.9px');assert.equal(f.css.get('--sp-vw'),'844px');
+ } finally {p.destroy();}
+ assert.equal(f.vv.count('scroll'),0);assert.equal(f.win.count('focus'),0);assert.equal(f.classes.has('sp-viewport-lock'),false);
+});
+test('keyboard editing follows the visible box without resetting the focused field',()=>{
+ const f=fixture();f.doc.activeElement={tagName:'INPUT',type:'text'};f.vv.height=210;f.vv.offsetTop=90;f.doc.scrollingElement.scrollTop=90;
+ const p=installViewportSupport(f.win);
+ try{
+  assert.equal(f.css.get('--sp-vy'),'90px');assert.equal(f.css.get('--sp-vh'),'2.1px');assert.equal(f.doc.scrollingElement.scrollTop,90);
+  const internal={scrollTop:88};f.doc.activeElement=null;f.vv.height=390;f.vv.offsetTop=0;f.doc.dispatchEvent({type:'focusout'});
+  assert.equal(f.css.get('--sp-vy'),'0px');assert.equal(f.doc.scrollingElement.scrollTop,0);assert.equal(internal.scrollTop,88);
+ }finally{p.destroy();}
+});
+test('visual viewport falls back to window metrics; range controls never count as keyboard editing',()=>{
+ const f=fixture();f.doc.activeElement={tagName:'INPUT',type:'range'};f.vv.offsetTop=29;
+ assert.equal(visibleViewport(f.win).editing,false);assert.equal(visibleViewport(f.win).y,0);
+ delete f.win.visualViewport;assert.deepEqual(visibleViewport(f.win),{width:844,height:390,x:0,y:0,editing:false});
+});
+
+function clock(win) {
+ const pending=new Map();let id=0;
+ win.setTimeout=(fn,delay)=>{pending.set(++id,{fn,delay});return id;};
+ win.clearTimeout=n=>pending.delete(n);
+ return {pending,run(delay){for(const [n,t] of [...pending])if(t.delay===delay){pending.delete(n);t.fn();}}};
+}
+
+test('resamples system-bar geometry after the browser stops sending viewport events',()=>{
+ const f=fixture(),c=clock(f.win),p=installViewportSupport(f.win);
+ try{
+  f.vv.height=340;f.vv.dispatchEvent({type:'resize'});
+  assert.equal(f.css.get('--sp-vh'),'3.4px');assert.equal(c.pending.size,3);
+  // Native UI settles without another resize. Recovery must read fresh values.
+  f.vv.height=390;f.win.scrollY=46;f.doc.scrollingElement.scrollTop=46;
+  c.run(400);
+  assert.equal(f.css.get('--sp-vh'),'3.9px');assert.equal(f.win.scrollY,0);
+  assert.equal(f.doc.scrollingElement.scrollTop,0);
+  for(let i=0;i<20;i++)f.doc.dispatchEvent({type:'pointercancel'});
+  assert.equal(c.pending.size,3,'recovery bursts replace previous timers');
+ }finally{p.destroy();}
+ assert.equal(c.pending.size,0,'destroy disposes delayed callbacks');
+ assert.equal(f.doc.count('touchend'),0);
+});
+
+test('delayed recovery keeps keyboard focus and internal scrolling intact',()=>{
+ const f=fixture(),c=clock(f.win),p=installViewportSupport(f.win);
+ try{
+  f.doc.activeElement={tagName:'INPUT',type:'text'};
+  f.doc.dispatchEvent({type:'focusin'});
+  f.vv.height=190;f.vv.offsetTop=80;f.doc.scrollingElement.scrollTop=80;
+  c.run(120);
+  assert.equal(f.css.get('--sp-vh'),'1.9px');assert.equal(f.css.get('--sp-vy'),'80px');
+  assert.equal(f.doc.scrollingElement.scrollTop,80);
+  f.doc.activeElement=null;f.doc.dispatchEvent({type:'focusout'});
+  f.vv.height=390;f.vv.offsetTop=0;c.run(900);
+  assert.equal(f.css.get('--sp-vh'),'3.9px');assert.equal(f.css.get('--sp-vy'),'0px');
+  assert.equal(f.doc.scrollingElement.scrollTop,0);
+ }finally{p.destroy();}
+});
