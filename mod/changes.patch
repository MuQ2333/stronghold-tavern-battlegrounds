diff --git a/shared/heroPowerPools.js b/shared/heroPowerPools.js
new file mode 100644
index 000000000..7499d8c3f
--- /dev/null
+++ b/shared/heroPowerPools.js
@@ -0,0 +1,19 @@
+// Separate policies for permanent replacement and Nguyen's one-turn powers.
+// Source records and known exclusions: docs/HERO-POWER-POOLS.md.
+import { heroPowerId } from './heroPowers.js';
+
+// Opening-only Expedition Plans is unavailable to Unmasked Identity.
+export const IDENTITY_HERO_BANS = Object.freeze(['faelin']);
+// Multi-turn progress / opening setup cannot be completed by a one-turn power.
+// [ASSUMED] adaptations of new cumulative powers follow this rule; exact server weights are not published.
+export const NGUYEN_HERO_BANS = Object.freeze(['nguyen', 'flurgl', 'eudora', 'guff', 'galewing', 'cookie', 'faelin', 'voone', 'thelan']);
+
+export function replacementHeroEligible(record, { temporary = false, round = 1, level = 1 } = {}) {
+  const id = heroPowerId(record);
+  if (!id) return false;
+  if ((temporary ? NGUYEN_HERO_BANS : IDENTITY_HERO_BANS).includes(id)) return false;
+  // Queen of Dragons is now an activated Tier-4 power, rather than its old upgrade-only version.
+  if (temporary && id === 'alexstrasza' && level < 4) return false;
+  if (temporary && (id === 'sylvanas' || id === 'yogg') && round < 3) return false;
+  return true;
+}
diff --git a/shared/heroPowers.js b/shared/heroPowers.js
new file mode 100644
index 000000000..a0370e126
--- /dev/null
+++ b/shared/heroPowers.js
@@ -0,0 +1,25 @@
+// Activated only by a loaded strategy record's params.heroPower. No global mod switch.
+export const HERO_POWER_IDS = Object.freeze([
+  'gallywix', 'sindragosa', 'millhouse', 'toki', 'mukla', 'elise', 'tess', 'flurgl',
+  'alexstrasza', 'nozdormu', 'maiev', 'eudora', 'omu', 'zephrys', 'guff', 'tamsin',
+  'galewing', 'cookie', 'faelin', 'togwaggle', 'sylvanas', 'voone', 'hoggarr', 'snakeeyes', 'cenarius',
+  'thelan', 'hollidae', 'yogg', 'scabbs', 'nguyen',
+]);
+export const SPELL_HERO_IDS = Object.freeze(['thelan', 'hollidae', 'yogg', 'galewing']);
+export const PASSIVE_HERO_IDS = Object.freeze(['gallywix','sindragosa','millhouse','mukla','flurgl','nozdormu','omu','guff','tamsin','voone','hoggarr','thelan','yogg','faelin','nguyen']);
+
+/** Shared by draft previews (initial state) and the authoritative current-use price. */
+export function heroPowerCost(id, {uses=0,discount=0} = {}) {
+  if(id==='elise') return 1+uses;
+  if(id==='togwaggle') return Math.max(0,11-discount);
+  if(['zephrys','cenarius'].includes(id)) return 3;
+  if(id==='sylvanas'||id==='scabbs') return 2;
+  return ['cookie','galewing','faelin'].includes(id)?0:1;
+}
+export function heroAvailable(record, spells = false) {
+  return !SPELL_HERO_IDS.includes(heroPowerId(record)) || spells === true;
+}
+export function heroPowerId(record) {
+  const id = record?.params?.heroPower;
+  return HERO_POWER_IDS.includes(id) ? id : null;
+}
