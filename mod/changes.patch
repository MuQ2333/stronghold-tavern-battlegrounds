+/** Forge form:elite keeps the normal chess identity and projects the elite's combat fields. @param {any} data */
+export function projectEliteData(data) {
+  if (!data || data.config?.forgeFormElite !== true || !data.chess) return data;
+  const source = data.chess;
+  const chess = { ...source };
+  for (const [id, rec] of Object.entries(source)) {
+    if (!rec || rec.isGolden === true || rec.isDiy === true || !rec.goldenId) continue;
+    const donor = source[rec.goldenId];
+    if (!donor || donor === rec) continue;
+    const projected = { ...donor };
+    for (const field of IDENTITY_FIELDS) {
+      if (Object.hasOwn(rec, field)) projected[field] = rec[field];
+      else delete projected[field];
+    }
+    projected.chessId = rec.chessId ?? rec.id ?? projected.chessId;
+    projected.baseId = rec.baseId ?? projected.baseId;
+    projected.goldenId = donor.chessId ?? donor.id ?? projected.goldenId;
+    projected.isGolden = false;
+    chess[id] = projected;
+  }
+  /** @param {any} tokens */
+  const projectTokens = tokens => {
+    if (!tokens || typeof tokens !== 'object') return tokens;
+    let out = tokens;
+    for (const [id, rec] of Object.entries(tokens)) {
+      if (!rec?.variants || typeof rec.variants !== 'object') continue;
+      let variants = rec.variants;
+      for (const owner of Object.keys(rec.variants)) {
+        const golden = owner.endsWith('_a') ? `${owner.slice(0, -2)}_b` : null;
+        if (!golden || !Object.hasOwn(rec.variants, golden) || !chess[owner] || !chess[golden]) continue;
+        if (variants === rec.variants) variants = { ...variants };
+        variants[owner] = rec.variants[golden];
+      }
+      if (variants !== rec.variants) {
+        if (out === tokens) out = { ...tokens };
+        out[id] = { ...rec, variants };
+      }
+    }
+    return out;
+  };
+  return { ...data, chess, tokens: projectTokens(data.tokens),
+    ...(data.backups ? { backups: { ...data.backups, tokens: projectTokens(data.backups.tokens) } } : {}) };
+}
