--- a/public/css/devices.css
+++ b/public/css/devices.css
@@ -126,13 +126,13 @@ html:not(.sp-in-match) .toast-host { margin-top: var(--sa-t); }
    the ⚙ row (DESIGN §35.43; test/ui/ui-size.test.js checks such mirrors). */
 @media (max-width: 767px) {
   .gm__corner { flex-wrap: wrap-reverse; align-content: flex-start; width: max(32px, calc(72px * var(--sp-ui, 1)), calc(3 * .56rem + .2rem)); }
-  .dpanel:not(.dpanel--right) { bottom: calc(.44rem + max(1.51rem, 32px, calc(72px * var(--sp-ui, 1))) * 55 / 151 + .56rem); }
+  .dpanel:not(.dpanel--right):not(.hero-power__panel) { bottom: calc(.44rem + max(1.51rem, 32px, calc(72px * var(--sp-ui, 1))) * 55 / 151 + .56rem); }
 }
 @media (max-width: 767px) and (pointer: coarse), (max-width: 767px) and (any-pointer: coarse) {
   .gm__corner { width: max(32px, calc(96px * var(--sp-ui, 1)), calc(3 * max(.56rem, 32px, calc(34px * var(--sp-ui, 1))) + .2rem)); }
   /* the 机变 overlay starts right of that corner (§35.51: at 2.8rem, 112 px on a 667 px phone, it covered 8 px of ⛶) */
   .gm.has-sp > .spov { left: calc(max(2.8rem, .24rem + max(32px, calc(96px * var(--sp-ui, 1)), calc(3 * max(.56rem, 32px, calc(34px * var(--sp-ui, 1))) + .2rem)) + 2px) + var(--sa-l)); }
-  .dpanel:not(.dpanel--right) { bottom: calc(.44rem + max(1.51rem, 32px, calc(96px * var(--sp-ui, 1))) * 55 / 151 + max(.56rem, 32px, calc(34px * var(--sp-ui, 1)))); }
+  .dpanel:not(.dpanel--right):not(.hero-power__panel) { bottom: calc(.44rem + max(1.51rem, 32px, calc(96px * var(--sp-ui, 1))) * 55 / 151 + max(.56rem, 32px, calc(34px * var(--sp-ui, 1)))); }
 }
 /* With the shop folded (收起) no bar covers the corner: one row again, so the folded shop's prep camera, which keeps the
    bench above the corner's hit areas (ui/fieldHost.js hudBands), grows the board on narrow phones too (public issue #5). */
@@ -179,3 +179,23 @@ html[data-fit] :is(.app-root, .st, .lo, .guide) {
 .set-fit__step { flex: none; width: .4rem; min-width: 28px; height: .34rem; min-height: 26px; padding: 0; border: 1px solid var(--line-2); background: rgba(0, 0, 0, .3);
   color: var(--text-hi); font-size: calc(.2 * var(--t)); line-height: 1; cursor: pointer; }
 .set-fit__step:disabled { opacity: .35; cursor: default; }
+
+/* Keep the document itself immobile when transient fullscreen browser/system bars return.
+   Internal lists and dispatch cards remain their own scroll containers. */
+html.sp-viewport-lock { overflow:hidden; width:100%; height:100%; }
+html.sp-viewport-lock body { position:fixed; inset:0; width:100%; height:100%; overflow:hidden; overscroll-behavior:none; }
+/* hidden still creates a programmatically scrollable box. clip prevents browser scroll
+   anchoring/scroll-into-view from retaining an offset after a fullscreen system gesture.
+   Keep hidden as the fallback on older engines; descendant lists remain scroll containers. */
+@supports (overflow:clip) {
+  html.sp-viewport-lock, html.sp-viewport-lock body { overflow:clip; }
+}
+.sp-viewport-lock .app-root { left:var(--sp-vx,0px); top:var(--sp-vy,0px); right:auto; bottom:auto; width:var(--sp-vw,100vw); height:calc(var(--sp-vh,1vh) * 100); }
+
+/* Mobile shop portraits stay clear; skill and module details remain in the card detail panel. */
+@media (max-height:600px) and (pointer:coarse), (max-width:767px) {
+  .gm .shopbar .scard__skill { display:none; }
+}
+
+/* Viewport recovery and manual screen fit compose on the same root box. */
+html.sp-viewport-lock[data-fit] .app-root { left:calc(var(--sp-vx,0px) + var(--fit-l,0px)); top:calc(var(--sp-vy,0px) + var(--fit-t,0px)); right:auto; bottom:auto; width:calc(var(--sp-vw,100vw) - var(--fit-l,0px) - var(--fit-r,0px)); height:calc(var(--sp-vh,1vh) * 100 - var(--fit-t,0px) - var(--fit-b,0px)); }
