diff --git a/public/js/ui/growthTrait.js b/public/js/ui/growthTrait.js
new file mode 100644
index 000000000..ff20f54d6
--- /dev/null
+++ b/public/js/ui/growthTrait.js
@@ -0,0 +1,19 @@
+import {t} from '../../../shared/i18n.js';
+import {data} from '../data.js';
+
+export function growthTraitLines(v) {
+  if (!v) return [];
+  const out=[];
+  if(v.gains)out.push(`${t('当前效果')}：${v.gains.map(x=>`${data.lookup('bonds',x.bondId)?.name || x.bondId} +${x.layers}`).join(' / ')}`);
+  if(v.value!=null)out.push(`${t('当前效果')} +${v.value}`);
+  if(v.recruitTier!=null)out.push(t('当前特殊招募：{tier}阶',{tier:v.recruitTier}));
+  if(v.spent!=null)out.push(t('消费进度：{spent}/9',{spent:v.spent}));
+  if(v.refreshProgress!=null)out.push(t('刷新进度：{count}/3',{count:v.refreshProgress}));
+  if(v.ammoProgress!=null)out.push(t('弹药进度：{count}/{total}',{count:v.ammoProgress,total:v.ammoThreshold}));
+  if(v.starSpent!=null)out.push(t('累计在场消费：{spent}；当前每3资金：+{layers}层',{spent:v.starSpent,layers:v.nextValue}));
+  if(v.overflow!=null)out.push(t('开战临时转移：{count}层',{count:v.overflow}));
+  if(v.summonsWaiting!=null)out.push(t('待击倒召唤物：{count}',{count:v.summonsWaiting}));
+  if(v.sale!=null)out.push(t('当前售价：{price}',{price:v.sale}));
+  if(v.repeat>1)out.push(t('特质触发次数：{count}',{count:v.repeat}));
+  return out;
+}
diff --git a/public/js/ui/heroDiscovery.js b/public/js/ui/heroDiscovery.js
new file mode 100644
index 000000000..5f3d46496
--- /dev/null
+++ b/public/js/ui/heroDiscovery.js
@@ -0,0 +1,21 @@
+import {t} from '../../../shared/i18n.js';
+
+/** Client-only adapter: share promotion reward cards without changing the hero/spell reward queues or endpoints. */
+export function heroDiscoveryOffer(hero, getChess, queued = 0, routes = false) {
+  if(routes&&hero?.id==='galewing'&&!hero.disabled&&!hero.used&&!hero.cooldown){
+    const lines=hero.desc.split('\n');
+    return {source:'hero-route',label:hero.name,choiceKey:`hero-route:${hero.id}:${hero.round??0}`,queued,
+      slots:[1,2,3].map(route=>{
+        const line=lines[route]||'',colon=line.indexOf('：');
+        return {kind:'heroRoute',id:`galewing-route-${route}`,heroRoute:true,route,price:0,sold:false,
+          name:colon<0?`${t('航线')} ${route}`:line.slice(0,colon),desc:colon<0?line:line.slice(colon+1)};
+      })};
+  }
+  if(!hero?.choices?.length)return null;
+  const tier=getChess(hero.choices[0].id)?.tier;
+  return {
+    source:'hero',label:hero.name,choiceKey:`hero:${hero.id}:${hero.sequence}`,queued,
+    ...(hero.id==='faelin'&&tier?{tier,hint:t('发现{tier}阶干员（{step}/3）',{tier,step:[6,4,2].indexOf(tier)+1})}:{}),
+    slots:hero.choices.map(x=>({kind:x.kind==='band'?'band':x.kind==='item'?'item':'chess',id:x.id,price:0,sold:false,...(x.kind==='band'?{spellBandChoice:true,temporaryPower:true}:{} )})),
+  };
+}
