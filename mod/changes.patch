+  const [key]=[...ps.deployMap()].find(([key])=>!ps.board.has(key)&&ps._legal(piece,...key.split(',').map(Number)));
+  ps._detach(ps.find(piece.uid));ps.board.set(key,piece);ps.recompute();return piece;
+}
