+/* Same root-rem scale and full-page geometry as Operator Loadout; px only for hairlines/readability floors. */
+.spell-preview { position:fixed; inset:0; width:100vw; height:100vh; height:100dvh; max-height:none; border:0; box-shadow:none; padding:var(--sa-t,0px) var(--sa-r,0px) var(--sa-b,0px) var(--sa-l,0px); }
+.spell-preview > .modal__body { min-height:0; flex:1; display:flex; flex-direction:column; overflow:hidden; padding:0; }
+.spell-preview__head { display:flex; align-items:center; gap:.2rem; min-height:max(1rem,48px); padding:.12rem .36rem; border-bottom:1px solid var(--line-2); flex:none; }
+.spell-preview__head h2 { margin:0; color:var(--text-hi); font-size:max(.32rem,16px); letter-spacing:.1em; }
+.spell-preview__head > span { margin-left:auto; color:var(--text-lo); font-size:max(.16rem,11px); }
+.spell-preview__filters { display:flex; align-items:end; flex-wrap:wrap; gap:.14rem; padding:.16rem .36rem .08rem; flex:none; }
+.spell-preview__filters label { display:flex; flex-direction:column; gap:.06rem; color:var(--text-lo); font-size:max(.15rem,10px); }
+.spell-preview__filters input,.spell-preview__filters select { min-height:max(.4rem,28px); padding:.06rem .12rem; border:1px solid var(--line-2); background:var(--bg-1); color:var(--text-hi); font:inherit; font-size:max(.17rem,12px); border-radius:0; }
+.spell-preview__search { flex:1; min-width:2rem; }
+.spell-preview__filters input:focus-visible,.spell-preview__filters select:focus-visible { outline:2px solid var(--mint-500); outline-offset:2px; }
+.spell-preview__note { padding:.04rem .36rem .12rem; margin:0; color:var(--text-lo); font-size:max(.15rem,10px); flex:none; }
+.spell-preview__list { min-height:0; overflow:auto; overscroll-behavior:contain; padding:.08rem .36rem .3rem; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); align-content:start; gap:.16rem; }
+.spell-preview-card { display:flex; align-items:flex-start; gap:.18rem; min-width:0; border:1px solid var(--line-2); background:rgba(17,24,23,.82); padding:.2rem; }
+.spell-preview-card__art { flex:none; width:1.05rem; height:1.05rem; min-width:0; min-height:0; display:block; overflow:hidden; background:rgba(141,94,192,.08); border:1px solid rgba(164,127,204,.35); }
+.spell-preview-card__art img { display:block; width:100%; height:100%; min-width:0; min-height:0; max-width:100%; max-height:100%; object-fit:contain; }
+.spell-preview-card__art.is-imported img { object-fit:cover; }
+.spell-preview-card__art .icon { width:.36rem; height:.36rem; color:var(--text-lo); margin:.3rem; }
+.spell-preview-card__info { min-width:0; flex:1; }
+.spell-preview-card header { display:flex; align-items:start; gap:.1rem; }
+.spell-preview-card h3 { color:var(--text-hi); font-size:max(.21rem,14px); line-height:1.4; margin:0; overflow-wrap:anywhere; }
+.spell-preview-card__tier { margin-left:auto; white-space:nowrap; color:var(--mint-400); font-size:max(.16rem,11px); }
+.spell-preview-card__meta { display:flex; flex-wrap:wrap; gap:.06rem .12rem; font-size:max(.15rem,10px); line-height:1.7; margin:.06rem 0; color:var(--text-lo); }
+.spell-preview-card__meta b { color:var(--gold); }
+.spell-preview-card__meta .spell-preview-card__disabled { color:var(--amber); }
+.spell-preview-card__effect { white-space:pre-wrap; line-height:1.7; font-size:max(.18rem,12px); color:var(--text-md); margin:.08rem 0 0; overflow-wrap:anywhere; }
+.spell-preview-card__choices { padding-left:.24rem; margin:.1rem 0 0; color:var(--text-md); font-size:max(.17rem,11px); line-height:1.6; }
+.spell-preview__empty { grid-column:1/-1; padding:.36rem; text-align:center; color:var(--text-lo); font-size:max(.18rem,12px); }
+.spell-preview-entry { flex:none; }
+.spell-preview .btn { font-size:max(.17rem,11px); min-height:max(.38rem,28px); padding:.06rem .14rem; }
+.spell-preview .btn__icon { width:max(.18rem,12px); height:max(.18rem,12px); }
+@media(max-width:760px) { .spell-preview__list { grid-template-columns:minmax(0,1fr); } .spell-preview__filters label { flex:1; min-width:1.4rem; } .spell-preview__filters .spell-preview__search { flex-basis:100%; } }
+@media(max-height:480px) { .spell-preview__head { min-height:.7rem; padding:.06rem .24rem; } .spell-preview__filters { padding:.08rem .24rem; gap:.1rem; } .spell-preview__filters label { gap:.02rem; } .spell-preview__note { padding:.02rem .24rem .06rem; } }
