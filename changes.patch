+/** The 1–4 player game this project is built on. Shared resources scale from this baseline and every scaling rule is
+ * the identity for a room holding at most this many players, so ≤4-player matches stay bit-for-bit what they were. */
+export const BASE_SEATS = 4;
+/** Seat counts a co-op room can be created with (host-only, before the match); `MAX_SEATS` is the largest of them. */
+export const ROOM_CAPACITIES = Object.freeze([4, 8, 12]);
+/** Capacity of a room created without one — the 4-seat game, so a client that never sends `capacity` is unaffected. */
+export const DEFAULT_SEATS = BASE_SEATS;
+/** Hard seat bound = the largest room capacity. Humans + AI teammates; the spectator seats (MAX_SPECTATORS) are extra. */
+export const MAX_SEATS = 12;
+/** Scale factor of the room-wide shared resources (card-pool copies, the hidden-core layer threshold) for a match of
+ * `players` seats: 1 up to BASE_SEATS, then one step per started block of BASE_SEATS (8 → 2, 12 → 3). */
+export const seatScale = (players) => Math.max(1, Math.ceil((Number(players) || 0) / BASE_SEATS));
