+  for (let i = 0; i < 3; i++) { assert.equal(ps.refresh().ok, true); assert.equal(ps.spellData().wisdom, 2 - i); }
+  assert.equal(ps.refresh().ok, true); assert.equal(ps.spellData().wisdom, 0);
+  h.m.dispose();
