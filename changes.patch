--- /dev/null
+++ b/tools/fetch-tavern-assets.mjs
@@ -0,0 +1,34 @@
+// Reuse the independent pack's verified strategy portraits; never include game art in a source patch.
+import fs from'node:fs/promises';
+import path from'node:path';
+import {fileURLToPath}from'node:url';
+import{HERO_POWER_IDS}from'../shared/heroPowers.js';
+const root=path.resolve(path.dirname(fileURLToPath(import.meta.url)),'..');
+const source=process.argv[2];
+if(!source)throw Error('Usage: node tools/fetch-tavern-assets.mjs <independent hero pack directory>; expects assets/art/');
+const dest=path.join(root,'public/assets/heroes');await fs.mkdir(dest,{recursive:true});
+const pack=JSON.parse(await fs.readFile(path.resolve(source,'pack.json'),'utf8'));
+for(const id of HERO_POWER_IDS){
+ if(id==='nguyen')continue;
+ const portrait=pack.art?.bands?.['band_hs_'+id],power=pack.art?.skills?.['hero_power_'+id];
+ if(!portrait||!power)throw Error('Missing source art mapping for '+id);
+ await fs.copyFile(path.resolve(source,'assets',portrait),path.join(dest,`strategy-${id}.png`));
+ await fs.copyFile(path.resolve(source,'assets',power),path.join(dest,`power-${id}.jpg`));
+}
+for(const [file,url] of [
+ ['strategy-nguyen.png','https://art.hearthstonejson.com/v1/heroes/latest/256x/BG20_HERO_202.png'],
+ ['power-nguyen.jpg','https://art.hearthstonejson.com/v1/256x/BG20_HERO_202p.jpg'],
+]) {
+ const output=path.join(dest,file);
+ try{await fs.access(output);}catch{
+  const r=await fetch(url,{signal:AbortSignal.timeout(30000)});if(!r.ok)throw Error(file+' '+r.status);
+  await fs.writeFile(output,Buffer.from(await r.arrayBuffer()));
+ }
+}
+const url='https://art.hearthstonejson.com/v1/heroes/latest/256x/TB_BaconShopBob.png';
+const bob=path.join(root,'public/assets/bob');await fs.mkdir(bob,{recursive:true});
+try{await fs.access(path.join(bob,'portrait.png'));}catch{
+ const response=await fetch(url,{signal:AbortSignal.timeout(30000)});if(!response.ok)throw Error('Bob art '+response.status);
+ await fs.writeFile(path.join(bob,'portrait.png'),Buffer.from(await response.arrayBuffer()));
+}
+console.log('Prepared 30 hero portraits and skill icons, and Bob portrait. No voice files generated.');
diff --git a/tools/install-bob-voices.mjs b/tools/install-bob-voices.mjs
new file mode 100644
index 0000000..b23a2e3
--- /dev/null
+++ b/tools/install-bob-voices.mjs
@@ -0,0 +1,28 @@
+// Install only reviewed, unchanged original lines. Generated samples require a separate approval.
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import {fileURLToPath} from 'node:url';
+const root=path.resolve(path.dirname(fileURLToPath(import.meta.url)),'..');
+const [planFile,audioDir]=process.argv.slice(2);
+if(!planFile||!audioDir)throw Error('Usage: node tools/install-bob-voices.mjs <generation-plan.json> <original-audio-directory>');
+const plan=JSON.parse(await fs.readFile(planFile,'utf8'));
+const cues={'需要补强':'loss','冻结商店':'freeze','出售干员':'sell','防守顺利':'win','本轮防守有漏怪':'loss','本轮完美防守':'win','连续完美防守':'streak','休整期闲聊':'idle','回到休整期':'prep','本局开场':'welcome','招募高阶干员':'buyHigh','招募中阶干员':'buyMid','招募低阶干员':'buyLow','普通战斗开始':'combat','升级调度中心':'upgrade','完成晋升':'triple','刷新商店':'refresh','新手招募／部署提示':'tutorial','可完成晋升':'tripleAvailable'};
+// Original-only mode also restores the reviewed strategy-selection line.
+cues['选择策略']='strategy';
+const bank={},assets=[];
+for(const line of plan.lines){
+ if(line.include!==1||line.number===34||line.audioMode!=='original')continue;
+ if(line.text!==line.original)throw Error(`Changed text cannot use original audio: ${line.number}`);
+ const cue=line.number===58?'firstWin':cues[line.category];
+ if(!cue)throw Error(`Unmapped approved line ${line.number}`);
+ const audioId=line.audioId||line.id;
+ const bytes=await fs.readFile(path.join(audioDir,audioId+'.wav'));
+ if(bytes.length<44||bytes.toString('ascii',0,4)!=='RIFF'||bytes.toString('ascii',8,12)!=='WAVE')throw Error('Invalid WAV: '+line.id);
+ const url='/assets/bob/voices/'+audioId+'.wav';
+ (bank[cue]??=[]).push({id:line.id,...(audioId!==line.id?{audioId}:{}),number:line.number,text:line.text,url});
+ assets.push({url,bytes});
+}
+await fs.mkdir(path.join(root,'public/assets/bob/voices'),{recursive:true});
+for(const a of assets)await fs.writeFile(path.join(root,'public',a.url),a.bytes);
+await fs.writeFile(path.join(root,'public/js/ui/bobVoiceManifest.js'),'// Generated from the reviewed script. Only unchanged original recordings; row 34 and AI samples excluded.\nexport const BOB_VOICE_MANIFEST=Object.freeze('+JSON.stringify(bank,null,2)+');\n');
+console.log(`Installed ${assets.length} reviewed original recordings in ${Object.keys(bank).length} cue groups.`);
diff --git a/tools/spell-art.mjs b/tools/spell-art.mjs
new file mode 100644
index 0000000..0b3a9ee
--- /dev/null
+++ b/tools/spell-art.mjs
@@ -0,0 +1,28 @@
+import {decodePng,encodePng} from './crop-board-atlas.mjs';
+
+/** Remove only continuous, nearly uniform white/black/transparent export mattes, not dark artwork. */
+export function trimSpellMatte(blob) {
+  const img=decodePng(blob),{w,h,rgba}=img;
+  const matte=(points)=>{
+    let min=255,max=0,opaque=0,blank=0;
+    for(const p of points){const i=p*4;if(rgba[i+3]<3){blank++;continue;}
+      opaque++;const rgb=[rgba[i],rgba[i+1],rgba[i+2]];min=Math.min(min,...rgb);max=Math.max(max,...rgb);
+    }
+    return blank===points.length || (opaque===points.length && max-min<=10 && (max<=18||min>=238));
+  };
+  const row=y=>Array.from({length:w},(_,x)=>y*w+x),col=x=>Array.from({length:h},(_,y)=>y*w+x);
+  let top=0,bottom=h,left=0,right=w;
+  while(top<h*.15&&matte(row(top)))top++;
+  while(bottom>h*.85&&matte(row(bottom-1)))bottom--;
+  while(left<w*.15&&matte(col(left)))left++;
+  while(right>w*.85&&matte(col(right-1)))right--;
+  if(!top&&!left&&bottom===h&&right===w)return {blob,rect:[0,0,w,h]};
+  return {blob:cropSpellImage(img,[left,top,right-left,bottom-top]),rect:[left,top,right-left,bottom-top]};
+}
+
+export function cropSpellImage(img,[x,y,w,h]) {
+  if(x<0||y<0||w<=0||h<=0||x+w>img.w||y+h>img.h)throw Error('Spell crop outside source');
+  const pixels=Buffer.alloc(w*h*4);
+  for(let row=0;row<h;row++)img.rgba.copy(pixels,row*w*4,((y+row)*img.w+x)*4,((y+row)*img.w+x+w)*4);
+  return encodePng(w,h,pixels);
+}
