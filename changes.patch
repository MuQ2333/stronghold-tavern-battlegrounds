+/* dmg-board/client/board.css — 结算页伤害看板。宿主是 `screen.result.footer` 固定浮层（引擎只给地址、不给样子：
+   `.mod-slot` 是 `position:fixed` 的贴底横条、`.mod-panel` 默认 `pointer-events:auto`），所以样子全在这里。
+
+   两条纪律：
+   * **只读的东西不吃点击**：本看板没有任何交互，整块 `pointer-events:none` —— 绝不能挡住结算屏自己的按钮。
+   * 数字一列一列对齐（`tabular-nums` + 右对齐），尺寸照引擎的 `max(.xxrem, Npx)` 约定（手机 root 缩放被夹在
+     40px，裸 rem 会小到看不清）。颜色只用引擎主题变量（theme.css），`theme-night` 那类主题包换色时这里跟着换。
+   * **`color-mix()` 是 Chrome 111+ 才有**，而客户端 WebView 下限比它老（引擎自己的兼容线）——每一处
+     `color-mix` 前面都写一行 rgba 兜底，老 WebView 用兜底色、新材料才用 exact 混色。 */
+
+.dmg-board {
+  max-width: min(96vw, 860px);
+  margin: 0 auto max(8px, env(safe-area-inset-bottom, 0px)) auto;
+  padding: max(.06rem, 6px) max(.1rem, 10px) max(.05rem, 5px);
+  background: rgba(20, 24, 22, .9); /* 兜底（老 WebView） */
+  background: color-mix(in srgb, var(--bg-1, #141816) 88%, transparent);
+  border: 1px solid var(--line-2, #3e4b45);
+  border-radius: max(.06rem, 6px);
+  box-shadow: 0 -2px 14px rgba(0, 0, 0, .35);
+  color: var(--text-md, #c3cbc7);
+  font-size: max(.14rem, 11px);
+  pointer-events: none; /* 只读：不吃点击 */
+  animation: dmg-board-in var(--t-fast, 150ms) var(--ease-out, ease) backwards;
+}
+@keyframes dmg-board-in { from { opacity: 0; transform: translateY(4px); } }
+
+.dmg-board__head {
+  display: flex;
+  align-items: baseline;
+  gap: max(.06rem, 8px);
+  padding-bottom: max(.03rem, 3px);
+}
+.dmg-board__head b { color: var(--text-hi, #f2f2f2); font-size: max(.15rem, 12px); letter-spacing: .04em; }
+.dmg-board__head small { color: var(--text-dim, #5d6863); }
+
+.dmg-board table {
+  width: 100%;
+  border-collapse: collapse;
+  table-layout: auto;
+}
+.dmg-board th, .dmg-board td {
+  padding: max(.02rem, 2px) max(.05rem, 6px);
+  text-align: right;
+  white-space: nowrap;
+}
+.dmg-board th {
+  color: var(--text-dim, #5d6863);
+  font-weight: 500;
+  font-size: max(.12rem, 10px);
+  border-bottom: 1px solid var(--line, #2f3a35);
+}
+.dmg-board td { border-top: 1px solid rgba(47, 58, 53, .55); }
+.dmg-board td { border-top: 1px solid color-mix(in srgb, var(--line, #2f3a35) 55%, transparent); }
+.dmg-board tbody tr:first-child td { border-top: none; }
+
+.dmg-board__rank { width: 1.6em; color: var(--text-dim, #5d6863); }
+.dmg-board__name {
+  text-align: left;
+  color: var(--text-hi, #f2f2f2);
+  max-width: 12em;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+.dmg-board__seat, .dmg-board__tag {
+  margin-left: max(.04rem, 4px);
+  color: var(--text-dim, #5d6863);
+  font-size: max(.11rem, 9px);
+}
+
+/* 第一名与伤害那一列：看板的第一眼 */
+.dmg-board tr.is-top .dmg-board__rank { color: var(--gold, #ffc600); font-weight: 700; }
+.dmg-board tr.is-top .dmg-board__name { color: var(--mint-400, #59f4ca); }
+.dmg-board__dmg {
+  position: relative;
+  color: var(--text-hi, #f2f2f2);
+  font-variant-numeric: tabular-nums;
+}
+.dmg-board__bar {
+  position: absolute;
+  left: 0; bottom: 1px;
+  width: var(--w, 0%);
+  height: 2px;
+  border-radius: 1px;
+  background: rgba(89, 244, 202, .55); /* 兜底（老 WebView） */
+  background: linear-gradient(90deg, var(--mint-400, #59f4ca), color-mix(in srgb, var(--mint-400, #59f4ca) 35%, transparent));
+}
+
+.dmg-board__bad { color: var(--amber, #f6a329); }
+.dmg-board__hint {
+  margin: max(.02rem, 2px) 0 0;
+  color: var(--text-dim, #5d6863);
+  font-size: max(.11rem, 9px);
+  text-align: right;
+}
