+    for (let i = 0; i < 80 && !loaded.has('/assets/spells/hoshiguma_shield.png'); i++) await new Promise(resolve => setTimeout(resolve, 100));
+    if (!loaded.has('/assets/spells/hoshiguma_shield.png')) {
